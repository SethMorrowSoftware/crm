# Castle CRM — Apache configuration
# Designed for cPanel shared hosting. Everything here degrades safely:
# if a directive's module is missing, the <IfModule> guard skips it and the
# front controller performs the same check in PHP (see app/bootstrap.php).

# ---------------------------------------------------------------------------
# Directory listings and dotfiles
# ---------------------------------------------------------------------------
Options -Indexes +FollowSymLinks

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# A DOTTED DIRECTORY, which the rule above does not cover.
#
# `<FilesMatch>` tests the file's own NAME, so it denies `/.env` and leaves
# `/.git/config` — a file called `config` that happens to live in a directory
# called `.git`. MEASURED: `GET /.git/config` returned 200. A venue whose
# install was deployed by cloning rather than unzipping would be publishing
# its entire repository history, including anything ever committed to it.
#
# `.well-known` is excluded because cPanel's AutoSSL answers its ACME
# challenge there, and denying it means certificate renewal silently stops —
# which is a different outage, arriving ninety days later.
RedirectMatch 404 (?i)(^|/)\.(?!well-known/)

# ---------------------------------------------------------------------------
# Never serve application internals, even if the rewrite rules are bypassed
# ---------------------------------------------------------------------------
# `tests` and `tools` are the dangerous two, and they were missing.
#
# The rewrite rules below let a REAL FILE through untouched — which they must,
# for the stylesheet and the installer — so every `.php` under those
# directories was directly executable over HTTP on an Apache install.
# MEASURED: `GET /tests/run.php` returned 500, meaning it ran. That file is the
# test runner: it boots against the configured database and, with `--fresh`,
# calls `test_drop_all()`. A venue's own data, one URL away from a suite that
# drops tables.
#
# Denied here AND guarded in PHP, because a host that ignores `.htaccess`
# (nginx in front, a different vhost) would otherwise have nothing between it
# and the request — same belt-and-braces rule the rest of this file follows.
RedirectMatch 404 (?i)^/(app|config|storage|tests|tools|install/(schema|seeds|steps))/
RedirectMatch 404 (?i)\.(sql|md|json|lock|log|sample\.php)$

<FilesMatch "(?i)\.(sql|log|ini|sh|bak|old|orig|swp|dist|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# Front controller
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # RewriteBase may need editing when installed in a subdirectory.
    # The installer prints the correct value if it detects a subdirectory install.
    # RewriteBase /

    # The Authorization header, which Apache does NOT pass to CGI/FastCGI by
    # default — so without this line every REST API token is rejected with
    # "this endpoint needs an API token", while the client can plainly see it
    # sent one. Nothing in the error says the server ate the header, which is
    # what makes it an afternoon rather than a minute.
    #
    # Two spellings because hosts differ about which one works: the CGI
    # passthrough, and the rewrite-environment variable that PHP then reads as
    # REDIRECT_HTTP_AUTHORIZATION (Request::collectHeaders handles both).
    <IfModule mod_setenvif.c>
        SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    </IfModule>
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

    # Used by the installer to prove mod_rewrite is active.
    RewriteRule ^__rewrite_probe$ install/probe.php [L]

    # Force HTTPS when the host terminates TLS upstream (cPanel + AutoSSL).
    # Commented by default so a pre-SSL install is still reachable.
    # RewriteCond %{HTTPS} !=on
    # RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Let the installer, real files, and real directories through untouched.
    RewriteRule ^install(/.*)?$ - [L]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else is the application.
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    # Without mod_rewrite the app still works at /index.php?_route=/path
    DirectoryIndex index.php
</IfModule>

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # HSTS is emitted by PHP only once HTTPS is confirmed, so a plain-HTTP
    # install is not locked out of its own domain.
    Header unset X-Powered-By
    Header always unset Server
</IfModule>

# ---------------------------------------------------------------------------
# Static asset caching (cache-busted by ?v=VERSION)
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# PHP settings (ignored silently when PHP runs as CGI/FPM without this module)
# ---------------------------------------------------------------------------
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
    php_value upload_max_filesize 16M
    php_value post_max_size 20M
    php_value max_execution_time 120
</IfModule>

ErrorDocument 404 /index.php
