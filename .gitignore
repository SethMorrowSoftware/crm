config/config.php
# What tests/run.php sets a real config aside as. A run killed mid-way leaves
# it behind, and it must never be committed.
config/config.php.testbackup
install/.lock
storage/logs/*
storage/cache/*
storage/uploads/*
storage/exports/*
storage/backups/*
# But the guards themselves ship, so a fresh deploy is protected before the
# first backup is ever taken rather than after it.
!storage/backups/.htaccess
!storage/backups/index.html
storage/sessions/*
!storage/**/.gitkeep
.DS_Store
*.log
# Local test scaffolding
/tests/.env.local
/tests/junit.xml

# Agent tooling scratch space. .claude/ itself can hold committed project
# config (skills, settings), but worktrees/ holds throwaway git worktrees —
# nested checkouts of this same repository, created and removed automatically.
/.claude/worktrees/

# Python bytecode from the CenterEdge tools, written beside them on every run.
__pycache__/
*.pyc
